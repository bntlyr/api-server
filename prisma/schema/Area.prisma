model Area {
  id       Int    @id @default(autoincrement())
  name     String
  category String

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  locations                       Location[]
  materialInventoryLots           MaterialInventoryLot[]
  fromMaterialTransactions        MaterialInventoryTransaction[]   @relation("FromAreaTransactions")
  toMaterialTransactions          MaterialInventoryTransaction[]   @relation("ToAreaTransactions")
  materialIssuanceItems           MaterialIssuanceItem[]
  finishedGoodsLots               FinishedGoodsLot[]
  fromFinishedGoodsTransactions   FinishedGoodsTransaction[]       @relation("FromAreaFGTransactions")
  toFinishedGoodsTransactions     FinishedGoodsTransaction[]       @relation("ToAreaFGTransactions")
  finishedGoodsAllocationRequests FinishedGoodsAllocationRequest[]

  @@index([deletedAt])
}
