model ItemRevision {
  id      Int     @id @default(autoincrement())
  ecnNo   String?
  details String

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  // Base audit & soft delete
  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([itemId])
  @@index([deletedAt])
}
