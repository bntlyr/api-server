model BoxContainer {
  id    Int    @id @default(autoincrement())
  boxNo String @unique

  salesOrderId Int?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  orderNo      String?

  boxTypeId Int
  boxType   BoxType @relation(fields: [boxTypeId], references: [id])

  status String @default("OPEN") // OPEN, CLOSED, SHIPPED, CANCELLED

  areaId     Int
  area       Area     @relation(fields: [areaId], references: [id])
  locationId Int
  location   Location @relation(fields: [locationId], references: [id])

  totalQty    Decimal @default(0) @db.Decimal(12, 2)
  grossWeight Decimal @default(0) @db.Decimal(12, 2)
  netWeight   Decimal @default(0) @db.Decimal(12, 2)

  remarks    String?
  closedAt   DateTime?
  closedById String?

  items BoxContainerItem[]

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([boxNo])
  @@index([salesOrderId])
  @@index([boxTypeId])
  @@index([areaId, locationId])
  @@index([status])
  @@index([deletedAt])
}
