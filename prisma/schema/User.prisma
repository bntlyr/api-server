model User {
  id        String    @id @default(uuid())
  username  String    @unique
  email     String    @unique
  name      String?
  password  String // Bcrypt with 12 salt rounds
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions               Session[]
  userPages              UserPage[]
  notificationRecipients NotificationRecipient[]

  @@index([deletedAt])
}
