model ItemRouteIteration {
  id      Int    @id @default(autoincrement())
  subname String

  itemRouteStepId Int
  itemRouteStep   ItemRouteStep @relation(fields: [itemRouteStepId], references: [id])

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([itemRouteStepId])
  @@index([deletedAt])
}
