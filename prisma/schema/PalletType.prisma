model PalletType {
  id          Int     @id @default(autoincrement())
  name        String
  description String
  unitPrice   Decimal @default(0) @db.Decimal(9, 2)
  weight      Decimal @default(0) @db.Decimal(9, 2)

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([deletedAt])
}
