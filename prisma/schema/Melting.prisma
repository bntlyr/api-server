model Melting {
  id            Int         @id @default(autoincrement())
  rawMaterialId Int
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  mixture       String?
  materialRatio String?
  meltingWeight Decimal?    @db.Decimal(9, 2)
  temperature   Decimal?    @db.Decimal(9, 2)
  additives     String?
  deoxidizer    String?

  createdById String?
  updatedById String?
  createdAt   DateTime  @default(now())
  createdBy   String?
  updatedAt   DateTime  @updatedAt
  updatedBy   String?
  deleted     Boolean   @default(false)
  deletedAt   DateTime?
  deletedBy   String?

  @@index([rawMaterialId])
  @@index([deletedAt])
}
