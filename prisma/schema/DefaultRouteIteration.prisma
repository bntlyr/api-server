model DefaultRouteIteration {
  id      Int    @id @default(autoincrement())
  subname String

  defaultRouteStepId Int
  defaultRouteStep   DefaultRouteStep @relation(fields: [defaultRouteStepId], references: [id])

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([defaultRouteStepId])
  @@index([deletedAt])
}
