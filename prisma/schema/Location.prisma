model Location {
  id   Int    @id @default(autoincrement())
  name String

  areaId                          Int
  area                            Area                             @relation(fields: [areaId], references: [id])
  materialInventoryLots           MaterialInventoryLot[]
  fromMaterialTransactions        MaterialInventoryTransaction[]   @relation("FromLocationTransactions")
  toMaterialTransactions          MaterialInventoryTransaction[]   @relation("ToLocationTransactions")
  materialIssuanceItems           MaterialIssuanceItem[]
  finishedGoodsLots               FinishedGoodsLot[]
  fromFinishedGoodsTransactions   FinishedGoodsTransaction[]       @relation("FromLocationFGTransactions")
  toFinishedGoodsTransactions     FinishedGoodsTransaction[]       @relation("ToLocationFGTransactions")
  finishedGoodsAllocationRequests FinishedGoodsAllocationRequest[]
  boxContainers                   BoxContainer[]

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([areaId])
  @@index([deletedAt])
}
