model Location {
  id   Int    @id @default(autoincrement())
  name String

  areaId Int
  area   Area @relation(fields: [areaId], references: [id])

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deletedAt DateTime?
  deletedBy String?

  @@index([areaId])
  @@index([deletedAt])
}
