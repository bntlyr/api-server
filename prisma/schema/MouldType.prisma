model MouldType {
  id         Int    @id @default(autoincrement())
  name       String
  itemTypeId Int?

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([itemTypeId])
  @@index([deletedAt])
}
