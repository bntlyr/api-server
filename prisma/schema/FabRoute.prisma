model FabRoute {
  id   Int    @id @default(autoincrement())
  name String
  type String @default("Default") // Either Default / Rework

  fabricationId Int
  fabrication   Fabrication @relation(fields: [fabricationId], references: [id])

  steps FabRouteStep[]

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([fabricationId])
  @@index([deletedAt])
}
