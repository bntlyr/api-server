model FabRouteIteration {
  id      Int    @id @default(autoincrement())
  subname String

  fabRouteStepId Int
  fabRouteStep   FabRouteStep @relation(fields: [fabRouteStepId], references: [id])

  createdAt DateTime  @default(now())
  createdBy String?
  updatedAt DateTime  @updatedAt
  updatedBy String?
  deleted   Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?

  @@index([fabRouteStepId])
  @@index([deletedAt])
}
