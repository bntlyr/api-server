{
  "name": "api-server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "type": "module",
  "bin": {
    "add": "./scripts/add-model.js",
    "init": "./scripts/init-module.js",
    "connect": "./scripts/connect.js",
    "disconnect": "./scripts/disconnect.js",
    "delete-connection": "./scripts/disconnect.js",
    "delete-model": "./scripts/delete-model.js",
    "remove-model": "./scripts/delete-model.js"
  },
  "scripts": {
    "connect": "node scripts/connect.js",
    "disconnect": "node scripts/disconnect.js",
    "delete:connection": "node scripts/disconnect.js",
    "remove:connection": "node scripts/disconnect.js",
    "init": "node scripts/init-module.js",
    "init:module": "node scripts/init-module.js",
    "delete:model": "node scripts/delete-model.js",
    "remove:model": "node scripts/delete-model.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "add": "node scripts/add-model.js",
    "add:model": "node scripts/add-model.js",
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "seed": "npx tsx scripts/seed-masters.ts",
    "seed:master": "npx tsx scripts/seed-masters.ts",
    "seed:all": "npx tsx scripts/reset-and-seed-all.ts",
    "db:reset-seed": "npx tsx scripts/reset-and-seed-all.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dataloader": "^2.2.3",
    "exceljs": "^4.4.0",
    "graphql": "^16.14.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.4",
    "@graphql-codegen/typescript": "^6.1.1",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "dotenv": "^18.0.6",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@apollo/protobufjs@1.2.8": true
  }
}
